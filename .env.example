# Copy to .env and override for anything real. Secrets ONLY come from here (constraint 14).
CLEAR_DB_PATH=data/clear.db
CLEAR_RAW_DATA_DIR=data/raw
CLEAR_MODEL_DIR=data/models
CLEAR_RANDOM_SEED=42
# Role-scoped bearer tokens (constraint 15). Change these for any shared deployment.
CLEAR_OPERATOR_TOKEN=dev-operator-token
CLEAR_CITIZEN_TOKEN=dev-citizen-token
CLEAR_INGEST_MAX_RETRIES=3
CLEAR_INGEST_BACKOFF_BASE_SECONDS=0.5
CLEAR_SLA_THRESHOLD_MINUTES=60
CLEAR_FORECAST_HORIZON_HOURS=3
CLEAR_HOTSPOT_EPS_METERS=150
CLEAR_HOTSPOT_MIN_SAMPLES=5
CLEAR_MAX_CLEARANCE_MINUTES=1440
CLEAR_DRIFT_PSI_THRESHOLD=0.2
