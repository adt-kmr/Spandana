# Copy to .env and override for anything real. Secrets ONLY come from here (constraint 14).
# Neon pooled connection string (Neon dashboard -> Connect -> "Pooled connection").
CLEAR_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
CLEAR_RAW_DATA_DIR=data/raw
CLEAR_MODEL_DIR=data/models
CLEAR_RANDOM_SEED=42
# Role-scoped bearer tokens (constraint 15). Change these for any shared deployment.
CLEAR_OPERATOR_TOKEN=dev-operator-token
CLEAR_CITIZEN_TOKEN=dev-citizen-token
# Comma-separated browser origins allowed to call the API (CORS). Add your deployed frontend
# origin(s) here in prod, e.g. https://your-frontend.vercel.app. Never use "*".
CLEAR_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# Rate limiting (fixed window, per worker). Set CLEAR_RATE_LIMIT_ENABLED=false to disable.
CLEAR_RATE_LIMIT_ENABLED=true
CLEAR_RATE_LIMIT_REQUESTS=120
CLEAR_RATE_LIMIT_WINDOW_SECONDS=60
CLEAR_INGEST_MAX_RETRIES=3
CLEAR_INGEST_BACKOFF_BASE_SECONDS=0.5
CLEAR_SLA_THRESHOLD_MINUTES=60
CLEAR_FORECAST_HORIZON_HOURS=3
CLEAR_HOTSPOT_EPS_METERS=150
CLEAR_HOTSPOT_MIN_SAMPLES=5
CLEAR_MAX_CLEARANCE_MINUTES=1440
CLEAR_DRIFT_PSI_THRESHOLD=0.2
# Gunicorn worker count (Postgres allows >1 now).
WEB_CONCURRENCY=2
